# Copy to .env and fill real values. Never commit .env.

SERVER_PORT=8090

# Same PostgreSQL as processing_backend (document chunks are read-only here)
DB_URL=jdbc:postgresql://127.0.0.1:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT — verify tokens issued by AuthBackend (public key only)
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=auth-api
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUERY_EMBEDDING_TTL=7200
REDIS_RETRIEVAL_TTL=900
REDIS_ANSWER_TTL=3600
REDIS_ANSWER_CACHE_ENABLED=false

# Embedding (must match document embedding profile)
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSIONS=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# LLM (independent of embedding provider)
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=qwen3.5:4b
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Retrieval tuning (experimental starting values)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70

CORS_ORIGIN=http://localhost:3000
